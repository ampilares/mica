{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mica",
  "version": "0.1.0",
  "identifier": "com.mica.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../apps/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../apps/desktop",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mica",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
